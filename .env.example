# Real PostgreSQL server protected by the proxy
DB_HOST=127.0.0.1
DB_PORT=5432

# Local proxy listener
PROXY_PORT=5433

# Separate read-only account used only for impact previews
ESTIMATOR_USER=sql_safety_estimator
ESTIMATOR_PASSWORD=change-me

# popup or cli
CONFIRMATION_MODE=popup

# sqlglot dialect
SQL_DIALECT=postgres
